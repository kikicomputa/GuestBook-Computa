/**
 * Menyelesaikan dan mengarsipkan event yang sedang aktif.
 * Mengubah status jadi SELESAI, menutup form, membersihkan data presensi, dan mereset cache.
 */
function apiArchiveEvent() {
  try {
    const ss = getDatabaseSpreadsheet ? getDatabaseSpreadsheet() : SpreadsheetApp.getActiveSpreadsheet();
    const masterSheet = ss.getSheetByName(CONFIG.DATABASE.MASTER_SHEET);
    if (!masterSheet || masterSheet.getLastRow() < 2) {
      return { status: "error", message: "Database event kosong." };
    }

    const rows = masterSheet.getDataRange().getValues();
    const headers = rows[0].map(h => String(h).trim().toLowerCase());
    
    // Cari letak kolom status dan form ID secara fleksibel
    let statusColIdx = headers.indexOf("status");
    let formIdColIdx = headers.indexOf("form id");
    if (statusColIdx === -1) statusColIdx = headers.length - 1;
    if (formIdColIdx === -1) formIdColIdx = 5;

    let targetEventFound = false;

    // Ubah semua event berstatus AKTIF atau TUTUP_FORM menjadi SELESAI
    for (let i = 1; i < rows.length; i++) {
      const currentStatus = String(rows[i][statusColIdx] || "").trim().toUpperCase();
      if (currentStatus === "AKTIF" || currentStatus === "TUTUP_FORM") {
        masterSheet.getRange(i + 1, statusColIdx + 1).setValue("SELESAI");
        targetEventFound = true;

        // Kunci respon Google Form
        try {
          const formId = rows[i][formIdColIdx];
          if (formId) {
            FormApp.openById(formId).setAcceptingResponses(false);
          }
        } catch (formErr) {
          Logger.log("Peringatan form tutup: " + formErr.message);
        }
      }
    }

    // Bersihkan baris di Presensi_Master agar counter langsung 0
    const presensiSheet = ss.getSheetByName(CONFIG.DATABASE.DATA_SHEET);
    if (presensiSheet && presensiSheet.getLastRow() > 1) {
      presensiSheet.deleteRows(2, presensiSheet.getLastRow() - 1);
    }

    // Bersihkan cache
    if (typeof CoreCache !== 'undefined') {
      CoreCache.remove("ACTIVE_EVENT");
      CoreCache.remove("ACTIVE_EVENT_META");
    }

    return { 
      status: "success", 
      message: targetEventFound ? "Event berhasil diarsipkan." : "Tidak ada event aktif yang perlu diarsipkan." 
    };

  } catch (err) {
    Logger.log("apiArchiveEvent Error: " + err.toString());
    return { status: "error", message: err.toString() };
  }
}

/**
 * 2. PENGAMBIL DATA ARSIP EVENT
 * Mengirim seluruh daftar event terdahulu untuk ditampilkan di tab 'Arsip Event'
 */
function apiGetArchives() {
  try {
    const ss = getDatabaseSpreadsheet ? getDatabaseSpreadsheet() : SpreadsheetApp.getActiveSpreadsheet();
    const masterSheet = ss.getSheetByName(CONFIG.DATABASE.MASTER_SHEET);
    if (!masterSheet || masterSheet.getLastRow() < 2) return [];

    const rows = masterSheet.getDataRange().getValues();
    const archives = [];

    // Baca dari baris kedua ke bawah
    for (let i = 1; i < rows.length; i++) {
      const r = rows[i];
      if (!r[0]) continue; // Lewati jika Event ID kosong

      archives.push({
        id: String(r[0] || "-"),
        title: String(r[1] || "Acara Tanpa Judul"),
        date: String(r[2] || "-"),
        time: String(r[3] || "-"),
        location: String(r[4] || "-"),
        status: String(r[7] || r[r.length - 1] || "SELESAI")
      });
    }

    // Tampilkan dari yang paling baru diarsipkan
    return archives.reverse();

  } catch (e) {
    Logger.log("apiGetArchives Error: " + e.toString());
    return [];
  }
}

