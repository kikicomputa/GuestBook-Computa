function doGet(e) {
  const page = (e && e.parameter && e.parameter.page) ? e.parameter.page : 'admin';
  const template = (page === 'screen') ? 'WelcomeScreen' : 'DashboardAdmin';

  return HtmlService.createTemplateFromFile(template)
    .evaluate()
    .setTitle(page === 'screen' ? 'Welcome Screen Computa' : 'Dashboard Presensi Computa')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)
    .addMetaTag('viewport', 'width=device-width, initial-scale=1.0');
}
